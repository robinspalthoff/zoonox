# =============================================================================
# zoonox — Environment-Referenz
# =============================================================================
# Kopie als `.env` (lokal) bzw. in Coolify als Environment-Variablen anlegen.
# Legende:  [PFLICHT] muss gesetzt sein · [PROD] für app.zoonox.de nötig ·
#           [OPTIONAL] Feature-abhängig · (default: …) Wert wenn nicht gesetzt.
# Niemals echte Secrets committen — diese Datei enthält nur Platzhalter.
# =============================================================================

# ── Core / App ───────────────────────────────────────────────────────────────
NODE_ENV=production                       # [PROD] production | development
NEXT_PUBLIC_APP_URL=https://app.zoonox.de # [PFLICHT] Basis-URL; baut u.a. die Enable-Banking-Redirect-URL
NEXT_PUBLIC_APP_NAME=zoonox               # [OPTIONAL] Anzeigename in der UI
PLATFORM_NAME=zoonox                      # [PROD] Absender-/Plattformname in E-Mails

# ── Auth (Auth.js / NextAuth) ────────────────────────────────────────────────
AUTH_URL=https://app.zoonox.de            # [PFLICHT] öffentliche URL der App
AUTH_SECRET=CHANGE_ME                     # [PFLICHT] `openssl rand -base64 32` — nie wiederverwenden
AUTH_TRUST_HOST=true                      # [PROD] hinter Reverse-Proxy (Coolify/Traefik) nötig
ALLOW_SIGNUP=false                        # [PROD] false = Selbst-Registrierung gesperrt (Riegel!)
# Google-Login (optional; ohne diese geht nur E-Mail/Passwort-Login):
AUTH_GOOGLE_ID=                           # [OPTIONAL]
AUTH_GOOGLE_SECRET=                       # [OPTIONAL]

# ── Datenbank ────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:postgres@localhost:5434/accounting_dev"

# ── Objektspeicher (Belege & Rechnungs-PDFs) ─────────────────────────────────
# WICHTIG: ohne STORAGE_DRIVER=r2 fällt die App auf lokalen Container-Speicher
# zurück → alle Uploads gehen bei jedem Redeploy verloren (GoBD-Bruch!).
STORAGE_DRIVER=r2                         # [PROD] "r2" (Cloudflare) oder "local" (nur Dev)
R2_ACCOUNT_ID=                            # [PROD] Cloudflare Account-ID
R2_ACCESS_KEY=                            # [PROD] R2 Access Key ID (alt. R2_ACCESS_KEY_ID)
R2_SECRET_ACCESS_KEY=                     # [PROD] R2 Secret Access Key
R2_BUCKET_NAME=zoonox-documents           # [PROD] Bucket für Belege/PDFs
# S3_ENDPOINT=                            # [OPTIONAL] überschreibt die aus R2_ACCOUNT_ID abgeleitete URL
# STORAGE_TENANT_PREFIX=default           # [OPTIONAL] Key-Prefix (default: "default")
# DOCUMENT_STORAGE_PATH=uploads/documents # [OPTIONAL] nur für STORAGE_DRIVER=local

# ── Objektspeicher-Backup (Cross-Region R2 → R2, via Worker) ─────────────────
# No-op solange leer. Sekundär-Bucket, idealerweise anderer Account/Region.
BACKUP_R2_ACCOUNT_ID=                     # [OPTIONAL/PROD]
BACKUP_R2_ACCESS_KEY_ID=                  # [OPTIONAL/PROD]
BACKUP_R2_SECRET_ACCESS_KEY=              # [OPTIONAL/PROD]
BACKUP_R2_BUCKET_NAME=                    # [OPTIONAL/PROD]
# BACKUP_R2_ENDPOINT=                     # [OPTIONAL] überschreibt abgeleitete Endpoint-URL

# ── E-Mail (Brevo) ───────────────────────────────────────────────────────────
# Ohne diese: kein Rechnungsversand, keine Team-Einladungen, kein Passwort-Reset.
BREVO_API_KEY=                            # [PROD] Brevo API-Key
PLATFORM_SENDER_EMAIL=noreply@zoonox.de   # [PROD] verifizierte Absenderadresse

# ── KI / OCR (Beleg-Erkennung) ───────────────────────────────────────────────
# Mindestens einer der beiden Keys, sonst ist die OCR/Belegerkennung deaktiviert.
MISTRAL_API_KEY=                          # [OPTIONAL/PROD]
OPENROUTER_API_KEY=                       # [OPTIONAL/PROD]
# OPENROUTER_MODEL=                       # [OPTIONAL] Model-Override

# ── Enable Banking (PSD2, read-only) ─────────────────────────────────────────
ENABLEBANKING_ENV=sandbox                 # [PROD] "sandbox" bis Prod-App freigeschaltet, dann "production"
ENABLEBANKING_APP_ID=                     # [PROD] App-ID (kid) aus dem EB-Control-Panel
ENABLEBANKING_PRIVATE_KEY_B64=            # [PROD] RS256-Private-Key (PKCS#8 PEM), base64-kodiert
# ENABLEBANKING_PRIVATE_KEY_PATH=         # [OPTIONAL] Alternative: Pfad zum Key auf Disk (Dev-Fallback)
# ENABLEBANKING_API_URL=                  # [OPTIONAL] (default: https://api.enablebanking.com)
# ENABLEBANKING_CONSENT_DAYS=90           # [OPTIONAL] angefragte Consent-Gültigkeit in Tagen

# ── Background-Worker ────────────────────────────────────────────────────────
# Deploy-Schalter (nur Produktion, NICHT in der lokalen .env — lokal startet
# man den Worker separat via `npm run worker`):
#   RUN_WORKER_INLINE=true  → Worker läuft im selben Container wie die Web-App
#   ROLE=worker             → dieser Container startet NUR den Worker (eigene Ressource)
# RUN_WORKER_INLINE=true
# ROLE=web
WORKER_LOG_LEVEL=info                     # [OPTIONAL] info | warn | error
# Cron-Overrides (Defaults in Klammern):
# WORKER_TICK_CRON=0 * * * *              # wiederkehrende Rechnungen (stündlich)
# WORKER_AFA_CRON=0 2 1 * *               # AfA/Abschreibungen (monatlich)
# WORKER_CLEANUP_CRON=0 3 * * *           # verwaiste Uploads räumen (täglich)
# WORKER_BACKUP_CRON=0 4 * * *            # R2-Objekt-Backup (täglich)
# WORKER_QUOTE_EXPIRE_CRON=30 1 * * *     # Angebote ablaufen lassen
# WORKER_BANK_SYNC_CRON=0 */6 * * *       # Enable-Banking Consent-Expiry + Re-Sync (alle 6h)
# DOCUMENT_ORPHAN_TTL_DAYS=30             # [OPTIONAL] Alter, ab dem verwaiste Uploads gelöscht werden

# ── Beleg-Einwurf per E-Mail (optional) ──────────────────────────────────────
INBOUND_EMAIL_DOMAIN=                     # [OPTIONAL] z. B. inbox.zoonox.de
INBOUND_WEBHOOK_SECRET=                   # [OPTIONAL] Shared-Secret für den Inbound-Webhook

# ── Optionale Integrationen ──────────────────────────────────────────────────
KOSIT_VALIDATOR_URL=                      # [OPTIONAL] XRechnung-Validator (eigener Container)

# ── Seed (nur einmalig zum Anlegen des ersten Admins) ────────────────────────
SEED_ADMIN_EMAIL=                         # nur für `npm run db:seed`
SEED_ADMIN_PASSWORD=                      # nur für `npm run db:seed`
SEED_ADMIN_FIRST_NAME=Admin               # (default: "Admin")
SEED_ADMIN_LAST_NAME=                     # (optional)
