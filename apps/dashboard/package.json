{
  "name": "zoonox-dashboard",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3001",
    "build": "next build",
    "start": "next start",
    "lint": "eslint src",
    "type-check": "tsc --noEmit",
    "test": "node --import tsx --test tests/unit/*.test.ts",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:seed": "npx tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "db:reset": "prisma migrate reset",
    "storage:migrate": "tsx scripts/migrate-storage-to-r2.ts",
    "storage:migrate:dry": "tsx scripts/migrate-storage-to-r2.ts --dry-run",
    "storage:backup": "tsx scripts/backup-r2.ts",
    "worker": "tsx scripts/worker.ts",
    "build:worker": "esbuild scripts/worker.ts --bundle --platform=node --format=cjs --packages=external --tsconfig=tsconfig.json --outfile=dist/worker.cjs",
    "postinstall": "prisma generate"
  },
  "prisma": {
    "seed": "npx tsx prisma/seed.ts"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.1",
    "@aws-sdk/client-s3": "^3.1038.0",
    "@aws-sdk/s3-request-presigner": "^3.1038.0",
    "@fontsource/poppins": "^5.2.7",
    "@getbrevo/brevo": "^3.0.0",
    "@prisma/client": "^6.19.2",
    "@react-email/components": "^0.0.27",
    "@react-email/render": "^1.0.5",
    "@react-pdf/renderer": "^4.3.0",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "jscanify": "^1.4.2",
    "jszip": "^3.10.1",
    "lucide-react": "^0.483.0",
    "mupdf": "^1.27.0",
    "next": "16.2.0",
    "next-auth": "^5.0.0-beta.30",
    "next-intl": "^4.8.3",
    "next-themes": "^0.4.6",
    "pdf-lib": "^1.17.1",
    "pg-boss": "^12.18.2",
    "qrcode": "^1.5.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "tailwind-merge": "^2.6.0",
    "xmlbuilder2": "^4.0.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.0",
    "prisma": "^6.4.0",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5"
  }
}
